# ============================================================
# ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!

# ============================================================
# SERVER
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# MONGODB ATLAS
# ============================================================
# Get your connection string from MongoDB Atlas dashboard
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chat-app?retryWrites=true&w=majority

# ============================================================
# FIREBASE ADMIN SDK
# ============================================================
# Create a service account in Firebase Console > Project Settings > Service Accounts
# Generate a new private key and paste the contents as a single line JSON string
# OR use the individual fields below
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# EMAIL (SendGrid / SMTP)
# ============================================================
# Use SendGrid for production, Gmail SMTP for development
SENDGRID_API_KEY=SG.xxxxx
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# OR
GMAIL_APP_PASSWORD=your-16-char-app-password

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ============================================================
# ADMIN
# ============================================================
ADMIN_EMAIL=admin@example.com

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ============================================================
# FILE UPLOAD
# ============================================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ============================================================
# ENCRYPTION (for database-level encryption)
# ============================================================
DB_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ============================================================
# SENTRY (error tracking - optional)
# ============================================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================================
# REDIS (for session store - optional, recommended for production)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# VERIFICATION
# ============================================================
# These are used to verify that environment variables are set
# (checked on server startup)
REQUIRED_ENV_VARS=MONGO_URI,FIREBASE_PROJECT_ID,JWT_SECRET,ADMIN_EMAIL
