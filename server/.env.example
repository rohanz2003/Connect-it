# ==========================================
# CONNECT IT - ENTERPRISE SECURE MESSAGING
# Environment Configuration Template
# ==========================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ==========================================

# ── MongoDB ──
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority

# ── Server ──
PORT=5000
NODE_ENV=development

# ── JWT Authentication ──
JWT_SECRET=02b4e318eb35fb62c7eaab824ad0c62e947143b84f4b1ac75e701412b4f1cb41

# ── Admin ──
ADMIN_EMAIL=zenderohan2012@gmail.com

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:3000

# ── Email (Resend API - HTTPS-based, works on Render) ──
# 1. Sign up at https://resend.com (free tier: 100 emails/day)
# 2. Get your API key at https://resend.com/api-keys
# 3. Set RESEND_API_KEY below
# 4. Optional: verify your own domain for custom "from" address
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev
ADMIN_FEEDBACK_EMAIL=zenderohan2012@gmail.com

# ── Push Notifications (VAPID) ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:zenderohan2012@gmail.com

# ── Optional: AI Chat ──
# OPENROUTER_API_KEY=your-openrouter-api-key
