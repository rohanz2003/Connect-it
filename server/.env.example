# ==========================================
# CONNECT IT - ENTERPRISE SECURE MESSAGING
# Environment Configuration Template
# ==========================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ==========================================

# ── MongoDB ──
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority
# Alternative: MONGODB_URI=...

# ── Server ──
PORT=5000
NODE_ENV=development

# ── JWT Authentication ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_MS=604800000

# ── Admin ──
ADMIN_EMAIL=admin@example.com

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:3000
# CLIENT_URL=http://localhost:3000

# ── Email Provider Options ──
# Choose ONE: Gmail SMTP, Outlook SMTP, SendGrid, or log-only (none)

# Option A: Gmail SMTP (recommended)
# 1. Enable 2FA at https://myaccount.google.com/
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-char password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=zenderohan2012@gmail.com
SMTP_PASS=htpc yzyk bugb bivm
FROM_EMAIL=zenderohan2012@gmail.com
ADMIN_EMAIL=zenderohan2012@gmail.com


# Option B: Outlook SMTP (uncomment and fill)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@outlook.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your@outlook.com

# Option C: SendGrid (uncomment and fill)
# SENDGRID_API_KEY=SG.xxxxx
# FROM_EMAIL=verified@yourdomain.com

# ── End-to-End Encryption ──
# 32+ char random hex string for at-rest encryption of messages
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENCRYPTION_KEY=7d8b66ea24ea109de9c138a77f7c979112d09a45e53bdbbbcec33b2cbd46abf6

# ── Firebase Admin SDK ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

