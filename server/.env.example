# ==========================================
# CONNECT IT - ENTERPRISE SECURE MESSAGING
# Environment Configuration Template
# ==========================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ==========================================

# ── MongoDB ──
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority

# ── Server ──
PORT=5000
NODE_ENV=development

# ── JWT Authentication ──
JWT_SECRET=02b4e318eb35fb62c7eaab824ad0c62e947143b84f4b1ac75e701412b4f1cb41

# ── Admin ──
ADMIN_EMAIL=zenderohan2012@gmail.com

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer - Gmail SMTP) ──
# 1. Enable 2FA at https://myaccount.google.com/
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-char password (no spaces)
EMAIL_USER=zenderohan2012@gmail.com
EMAIL_PASS=your16charapppassword
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=zenderohan2012@gmail.com
SMTP_PASS=your16charapppassword
FROM_EMAIL=zenderohan2012@gmail.com
ADMIN_FEEDBACK_EMAIL=zenderohan2012@gmail.com

# ── Push Notifications (VAPID) ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:zenderohan2012@gmail.com

# ── Optional: AI Chat ──
