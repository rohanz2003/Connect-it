# Copy these into Render Dashboard → Environment (NOT as a .env file upload).
# .env is gitignored and is NOT deployed to Render.

# MongoDB Atlas connection string (do NOT use localhost on Render)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority

PORT=5000

# Admin OTP login
ADMIN_EMAIL=your-admin@gmail.com
JWT_SECRET=replace-with-a-long-random-secret

# ──────────────────────────────────────────────
# EMAIL PROVIDERS — choose ONE of the options below
# ──────────────────────────────────────────────

# ── Option A: Gmail SMTP (recommended) ──
# 1. Enable 2FA → https://myaccount.google.com/apppasswords
# 2. Generate a 16-char App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=your@gmail.com

# ── Option B: Outlook/Office365 SMTP ──
# Requires Outlook account. Enable 2FA → App Password.
# Comment OUT Gmail vars above, uncomment these:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@outlook.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your@outlook.com

# ── Option C: SendGrid ──
# Comment OUT all SMTP vars above, uncomment:
# SENDGRID_API_KEY=SG.xxxxx
# FROM_EMAIL=verified@yourdomain.com

# ── Option D: Log only ──
# Leave ALL email vars unset. Emails / OTP codes will appear in Render logs.

# ──────────────────────────────────────────────

# Where feedback notification emails go (defaults to ADMIN_EMAIL if not set)
# ADMIN_FEEDBACK_EMAIL=your-admin@gmail.com

# Vercel frontend URL (for CORS) — FRONTEND_URL or CLIENT_URL
FRONTEND_URL=https://connect-it.vercel.app
# CLIENT_URL=https://connect-it.vercel.app

# Encrypt message content at rest (32+ char random string recommended)
MESSAGE_ENCRYPTION_KEY=replace-with-long-random-secret
